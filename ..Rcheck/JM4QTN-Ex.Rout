> ##D   c("Trait1", "Trait2"), pheno_data, geno_data,
> ##D   npt = 500, alpha = 0.05, sle = 0.01, sls = 0.01
> ##D )
> ##D 
> ##D # Example with three traits
> ##D pheno_data_3t <- cbind(pheno_data, Trait3 = rnorm(100, mean = 25, sd = 5))
