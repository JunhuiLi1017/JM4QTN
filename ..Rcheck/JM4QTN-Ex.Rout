> cleanEx()
> nameEx("genotype_prob")
> ### * genotype_prob
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: genotype_prob
> ### Title: Calculate Genotype Probabilities and Impute Missing Data
> ### Aliases: genotype_prob
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example genetic map
> ##D genetic_map <- data.frame(
> ##D   marker = c("M1", "M2", "M3", "M4", "M5"),
> ##D   chr = c(1, 1, 1, 1, 1),
> ##D   pos = c(0, 10, 25, 40, 50)
> ##D )
> ##D 
> ##D # Example genotype data with missing values
> ##D geno_data <- matrix(
> ##D   c(2, 0, NA, 1, 2,
> ##D     1, 0, 2, NA, 0,
> ##D     2, 1, 0, 2, 1,
> ##D     0, NA, 1, 0, 2),
> ##D   nrow = 4, ncol = 5,
> ##D   dimnames = list(c("Ind1", "Ind2", "Ind3", "Ind4"), 
> ##D                   c("M1", "M2", "M3", "M4", "M5"))
> ##D )
> ##D 
> ##D # Association mapping (no imputation)
> ##D result_am <- genotype_prob(genetic_map, geno_data, method = "AM")
> ##D 
> ##D # Linkage mapping for F2 population with imputation
> ##D result_lm <- genotype_prob(genetic_map, geno_data, method = "LM", 
> ##D                         croType = "F2", steps = 0)
> ##D 
> ##D # Linkage mapping with virtual marker creation
> ##D result_lm_vm <- genotype_prob(genetic_map, geno_data, method = "LM", 
> ##D                            croType = "F2", steps = 5)
> ##D 
> ##D # RIL population example
> ##D result_ril <- genotype_prob(genetic_map, geno_data, method = "LM", 
> ##D                          croType = "RIL", steps = 0)
> ## End(Not run)
> 
> 
> 
