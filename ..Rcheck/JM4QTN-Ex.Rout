> 
> ### Name: perm_test_joint
> ### Title: Permutation Test for Joint Mapping Analysis
> ### Aliases: perm_test_joint
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example phenotype data
> ##D pheno_data <- data.frame(
> ##D   Indi = paste0("Ind", 1:100),
> ##D   Popu = rep(c("Pop1", "Pop2"), each = 50),
> ##D   MA = rep(1:2, 50),
> ##D   PA = rep(1:2, 50),
> ##D   Trait1 = rnorm(100, mean = 100, sd = 15),
> ##D   Trait2 = rnorm(100, mean = 50, sd = 8)
> ##D )
> ##D 
> ##D # Example genotype data
> ##D geno_data <- matrix(sample(c(0,1,2), 100*50, replace = TRUE), 
> ##D                     nrow = 100, ncol = 50)
> ##D colnames(geno_data) <- paste0("M", 1:50)
> ##D 
> ##D # Permutation test for association mapping
> ##D thresholds_am <- perm_test_joint(c("Trait1", "Trait2"), pheno_data, geno_data, 
> ##D                      method = "AM", npt = 100, alpha = 0.1)
> ##D 
> ##D # Permutation test for linkage mapping
> ##D thresholds_lm <- perm_test_joint(c("Trait1", "Trait2"), pheno_data, geno_data, 
> ##D                      method = "LM", npt = 100, alpha = 0.1)
> ##D 
> ##D # View results
> ##D print(thresholds_am)
> ##D print(thresholds_lm)
> ##D 
> ##D # Example with different parameters
> ##D thresholds_custom <- perm_test_joint(c("Trait1", "Trait2"), pheno_data, geno_data,
> ##D                          method = "AM", npt = 500, alpha = 0.05,
> ##D                          sle = 0.01, sls = 0.01)
> ## End(Not run)
> 
> 
> 
