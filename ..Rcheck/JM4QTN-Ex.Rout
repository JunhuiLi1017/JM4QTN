> cleanEx()
> nameEx("joint_map")
> ### * joint_map
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: joint_map
> ### Title: Joint Mapping Analysis for Multiple Traits
> ### Aliases: joint_map
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example phenotype data
> ##D pheno_data <- data.frame(
> ##D   Indi = paste0("Ind", 1:100),
> ##D   Popu = rep(c("Pop1", "Pop2"), each = 50),
> ##D   MA = rep(1:2, 50),
> ##D   PA = rep(1:2, 50),
> ##D   Trait1 = rnorm(100, mean = 100, sd = 15),
> ##D   Trait2 = rnorm(100, mean = 50, sd = 8)
> ##D )
> ##D 
> ##D # Example genotype data
> ##D geno_value <- matrix(sample(c(0,1,2), 100*50, replace = TRUE), 
> ##D                    nrow = 100, ncol = 50)
> ##D colnames(geno_value) <- paste0("M", 1:50)
> ##D geno_header <- data.frame(chr = rep(1:5, each = 10), pos = 1:50)
> ##D geno_est <- rbind(t(geno_header),geno_value)
> ##D 
> ##D # Heritability values
> ##D h2 <- c(0.3, 0.4)
> ##D 
> ##D # Threshold values from permutation test
> ##D thresholds_am <- c(0.05, 0.05)  # P-value thresholds for AM
> ##D thresholds_lm <- c(0.05, 0.05, 2.5, 3.0)  # P-value and LOD thresholds for LM
> ##D 
> ##D # Joint mapping analysis - Association mapping
> ##D results_am <- joint_map(c("Trait1", "Trait2"), h2, pheno_data, method = "AM",
> ##D                  thresholds_am, geno_est)
> ##D 
> ##D # View results for first trait
> ##D print(results_am$Trait1)
> ##D 
> ##D # Joint mapping analysis - Linkage mapping
> ##D geno_qtl <- matrix(sample(c(0,1,2), 100*30, replace = TRUE), 
> ##D                    nrow = 100, ncol = 30)
> ##D colnames(geno_qtl) <- paste0("Q", 1:30)
> ##D 
> ##D results_lm <- joint_map(c("Trait1", "Trait2"), h2, pheno_data, method = "LM",
> ##D                  thresholds_lm, geno_est, geno_qtl)
> ##D 
> ##D # View results for second trait
> ##D print(results_lm$Trait2)
> ##D 
> ##D # Example with three traits
> ##D pheno_data_3t <- cbind(pheno_data, Trait3 = rnorm(100, mean = 25, sd = 5))
> ##D h2_3t <- c(0.3, 0.4, 0.25)
> ##D thresholds_3t <- c(0.05, 0.05, 0.05, 2.5, 3.0, 2.8)
> ##D 
> ##D results_3t <- joint_map(c("Trait1", "Trait2", "Trait3"), h2_3t, pheno_data_3t, 
> ##D                  method = "AM", thresholds_3t[1:3], geno_est)
> ## End(Not run)
> 
> 
> 
> cleanEx()
> nameEx("link_pleio")
> ### * link_pleio
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: link_pleio
> ### Title: Linkage-Pleiotropy Analysis for QTL Detection
> ### Aliases: link_pleio
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example phenotype data
> ##D pheno_data <- data.frame(
> ##D   Indi = paste0("Ind", 1:100),
> ##D   Popu = rep(c("Pop1", "Pop2"), each = 50),
> ##D   MA = rep(1:2, 50),
> ##D   PA = rep(1:2, 50),
> ##D   Trait1 = rnorm(100, mean = 100, sd = 15),
> ##D   Trait2 = rnorm(100, mean = 50, sd = 8)
> ##D )
> ##D 
> ##D # Example genotype data
> ##D geno_est <- matrix(sample(c(0,1,2), 100*50, replace = TRUE), 
> ##D                    nrow = 100, ncol = 50)
> ##D geno_qtl <- matrix(sample(c(0,1,2), 100*30, replace = TRUE), 
> ##D                    nrow = 100, ncol = 30)
> ##D colnames(geno_est) <- paste0("M", 1:50)
> ##D colnames(geno_qtl) <- paste0("Q", 1:30)
> ##D 
> ##D # Threshold values from permutation test
> ##D thresholds <- c(0.05, 0.05, 2.5, 3.0, 2.8)  # Example thresholds
> ##D 
> ##D # Linkage-pleiotropy analysis
> ##D results <- link_pleio(
> ##D   c("Trait1", "Trait2"), pheno_data, geno_est, geno_qtl,
> ##D   thresholds, CChr = 1, Interval = c(0, 100), nPB = 100, alpha = 0.05
> ##D )
> ##D 
> ##D # View results
> ##D print(results)
> ##D 
> ##D # Example with different parameters
> ##D results_custom <- link_pleio(
> ##D   c("Trait1", "Trait2"), pheno_data, geno_est, geno_qtl,
> ##D   thresholds, CChr = 2, Interval = c(20, 80), 
> ##D   nPB = 500, alpha = 0.01
> ##D )
> ##D 
> ##D # Example with three traits
> ##D pheno_data_3t <- cbind(pheno_data, Trait3 = rnorm(100, mean = 25, sd = 5))
> ##D geno_qtl_3t <- matrix(sample(c(0,1,2), 100*40, replace = TRUE), 
> ##D                       nrow = 100, ncol = 40)
> ##D colnames(geno_qtl_3t) <- paste0("Q", 1:40)
> ##D 
> ##D thresholds_3t <- c(0.05, 0.05, 0.05, 2.5, 3.0, 2.8, 2.7)
> ##D results_3t <- link_pleio(
> ##D   c("Trait1", "Trait2", "Trait3"), pheno_data_3t, geno_est, geno_qtl_3t,
> ##D   thresholds_3t, CChr = 1, Interval = c(0, 100), nPB = 100
> ##D )
> ## End(Not run)
> 
> 
> 
> 
