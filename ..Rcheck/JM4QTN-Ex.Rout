> ### Name: expected_genotype_dist
> ### Title: Expected Allele Genotype Distribution Calculator
> ### Aliases: expected_genotype_dist
> ###   calculate_expected_genotype_distribution
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate probability for F2 population with both flanking markers
> ##D prob_f2 <- expected_genotype_dist("22", "F2", Gn = 2, x = 0.1, y = 0.2)
> ##D 
> ##D # Calculate probability for BCP1 with only right flanking marker
> ##D prob_bcp1_n2 <- expected_genotype_dist("N2", "BCP1", Gn = 3, x = 0.15, y = 0.25)
> ##D 
> ##D # Calculate probability for DH population with only left flanking marker
> ##D prob_dh_2n <- expected_genotype_dist("2N", "DH", Gn = 2, x = 0.1, y = 0)
> ##D 
> ##D # Calculate probability for Fn population with both flanking markers
> ##D prob_fn <- expected_genotype_dist("21", "Fn", Gn = 4, x = 0.2, y = 0.3)
> ##D 
> ##D # Calculate probability for RIL population
> ##D prob_ril <- expected_genotype_dist("00", "RIL", Gn = 2, x = 0.1, y = 0.2)
> ##D 
> ##D # Example with different recombination fractions
> ##D prob_low_rec <- expected_genotype_dist("22", "F2", Gn = 2, x = 0.05, y = 0.05)
> ##D prob_high_rec <- expected_genotype_dist("22", "F2", Gn = 2, x = 0.3, y = 0.4)
> ## End(Not run)
> 
> 
> 
