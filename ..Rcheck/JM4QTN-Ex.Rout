> ### Name: perm_test_link_pleio
> ### Title: Permutation Test for Linkage-Pleiotropy Analysis
> ### Aliases: perm_test_link_pleio
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example phenotype data
> ##D pheno_data <- data.frame(
> ##D   Indi = paste0("Ind", 1:100),
> ##D   Popu = rep(c("Pop1", "Pop2"), each = 50),
> ##D   MA = rep(1:2, 50),
> ##D   PA = rep(1:2, 50),
> ##D   Trait1 = rnorm(100, mean = 100, sd = 15),
> ##D   Trait2 = rnorm(100, mean = 50, sd = 8)
> ##D )
> ##D 
> ##D # Example genotype data
> ##D geno_data <- matrix(sample(c(0,1,2), 100*50, replace = TRUE), 
> ##D                     nrow = 100, ncol = 50)
> ##D colnames(geno_data) <- paste0("M", 1:50)
> ##D 
> ##D # Permutation test for linkage-pleiotropy analysis
> ##D thresholds <- perm_test_link_pleio(
> ##D   c("Trait1", "Trait2"), pheno_data, geno_data, 
> ##D   npt = 100, alpha = 0.1
