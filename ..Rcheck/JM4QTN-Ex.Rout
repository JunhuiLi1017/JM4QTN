> ### Name: genotype_freq
> ### Title: Genotype Frequency Calculator for Genetic Populations
> ### Aliases: genotype_freq calculate_genotype_frequencies
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate frequency for F2 generation, genotype 1, with recombination fraction 0.1
> ##D freq_f2 <- genotype_freq("Fn", generation = 2, genotype_index = 1, recomb_aq = 0.1, recomb_qb = 0)
> ##D 
> ##D # Calculate frequency for BCP1 generation, genotype 5, with recombination fractions
> ##D freq_bcp1 <- genotype_freq(
> ##D   "BCP1", generation = 3, genotype_index = 5, recomb_aq = 0.15, recomb_qb = 0.25
> ##D )
> ##D 
> ##D # Calculate frequency for Fn generation, genotype 10, with recombination fractions
> ##D freq_fn <- genotype_freq(
> ##D   "Fn", generation = 4, genotype_index = 10, recomb_aq = 0.2, recomb_qb = 0.3
> ##D )
> ##D 
> ##D # Calculate frequency for BCP2 generation, genotype 3
> ##D freq_bcp2 <- genotype_freq(
> ##D   "BCP2", generation = 2, genotype_index = 3, recomb_aq = 0.1, recomb_qb = 0.2
> ##D )
> ##D 
> ##D # Example with different generation numbers
> ##D freq_gen3 <- genotype_freq("Fn", generation = 3, genotype_index = 1, recomb_aq = 0.1, recomb_qb = 0)
> ##D freq_gen5 <- genotype_freq("Fn", generation = 5, genotype_index = 1, recomb_aq = 0.1, recomb_qb = 0)
> ## End(Not run)
> 
> 
