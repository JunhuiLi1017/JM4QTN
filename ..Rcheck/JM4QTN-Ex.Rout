> nameEx("pheno_stats")
> ### * pheno_stats
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: pheno_stats
> ### Title: Statistical Analysis of Phenotype Data
> ### Aliases: pheno_stats
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Example with multiple environments and blocks
> ##D pheno_data <- data.frame(
> ##D   E = rep(c("Env1", "Env2", "Env3"), each = 60),
> ##D   B = rep(c("Block1", "Block2"), each = 30, times = 3),
> ##D   R = rep(1:5, 36),
> ##D   G = rep(1:12, 15),
> ##D   Height = rnorm(180, 175, 8),
> ##D   Weight = rnorm(180, 75, 12)
> ##D )
> ##D 
> ##D # Perform statistical analysis with default formulas
> ##D results <- pheno_stats(pheno_data)
> ##D 
> ##D # View normality test results
> ##D results$Height$normality_test
> ##D 
> ##D # View ANOVA results
> ##D results$Height$ANOVA
> ##D 
> ##D # View least squares means
> ##D results$Height$lsmeans
> ##D 
> ##D # Example with custom formulas
> ##D custom_formulas <- c(
> ##D   "Height ~ E + G + E:G + B%in%E",
> ##D   "Weight ~ E + G + E:G"
> ##D )
> ##D results_custom <- pheno_stats(pheno_data, defineForm = custom_formulas)
> ## End(Not run)
> 
> 
> 
